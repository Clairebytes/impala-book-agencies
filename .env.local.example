# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — bypasses row-level security. Do NOT prefix with NEXT_PUBLIC_
# and never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
